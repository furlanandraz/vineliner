# ---------------------------------------------------------------------------
# Vineliner
# ---------------------------------------------------------------------------

# Test data is data, not code, and stays local: imagery (dof/) and vineyard
# polygons (poly/). Imagery anywhere else is not versioned either.
/dof/
/poly/
*.tif
*.tiff

# Raster sidecar files created next to the imagery (GDAL/QGIS statistics,
# world files, overviews). They belong with the ignored imagery.
*.aux.xml
*.tfw
*.ovr

# GeoPackage lock/journal files created while a layer is open in QGIS.
*.gpkg-wal
*.gpkg-shm
*.gpkg-journal

# Run outputs: intermediate rasters, score surfaces, exports, reports.
runs/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

